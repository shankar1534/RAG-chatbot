# Copy this file to .env and adjust the values as needed.

# Port the Express server listens on (default: 3000)
PORT=3000

# Base URL for your local Ollama instance (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model used for chat / answer generation (default: llama3.2)
OLLAMA_CHAT_MODEL=llama3.2

# Ollama model used for generating embeddings (default: nomic-embed-text)
# Note: embeddings are only used if you extend simpleStore.js with vector search.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Minimum similarity score (0.0–1.0) for a document chunk to be treated as
# relevant to the user's question (Tier 1 threshold). Lower = more permissive.
# Default: 0.3
RELEVANCE_THRESHOLD=0.3
